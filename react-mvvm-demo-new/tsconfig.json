{ 
  "compilerOptions": {
    "target": "ES2018",
    "module": "commonjs",
    "jsx": "preserve",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "experimentalDecorators": false,
    "strict": true,
    "skipLibCheck": true,
    "paths": {
      "my-objects": ["./src/my-objects"],
      "my-objects/*": ["./src/my-objects/*"],
      "my-objects-antd": ["./src/my-objects-antd"],
      "my-objects-antd/*": ["./src/my-objects-antd/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "tests/**/*.ts", "tests/**/*.tsx"]
}
